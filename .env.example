# Rename this file to .env and fill in values as needed.
PORT=3000

# Set to "true" to disable auth enforcement for local development.
# When not set (or set to anything other than "true"), all auth keys below
# are REQUIRED — requests to endpoints with missing keys will be rejected with 500.
AGENTGATE_DEV_MODE=true
AGENTGATE_HTTP_ALLOWLIST=
AGENTGATE_HTTP_TIMEOUT_MS=5000
AGENTGATE_HTTP_MAX_BODY_BYTES=65536

# Max response body size (bytes) for outbound market.http requests. Requests whose response
# exceeds this limit are aborted and logged as a response_too_large security event.
# Default: 1048576 (1 MB)
AGENTGATE_MAX_RESPONSE_BYTES=

# Secret key for MCP HTTP endpoint auth. Set this to a long random string to require
# an x-agentgate-key header on all MCP requests. Required unless AGENTGATE_DEV_MODE=true.
AGENTGATE_MCP_KEY=

# Secret key for REST API auth. When set, all POST requests to /v1/* endpoints require
# an x-agentgate-key header matching this value. Required unless AGENTGATE_DEV_MODE=true.
AGENTGATE_REST_KEY=

# Secret key for admin endpoint auth. When set, all POST requests to /admin/* endpoints
# require an x-agentgate-key header matching this value. Required unless AGENTGATE_DEV_MODE=true.
AGENTGATE_ADMIN_KEY=

# Secret key for dashboard auth. When set, the /dashboard page requires HTTP Basic Auth
# (username: admin, password: this value).
# Leave unset to disable auth (local dev only).
AGENTGATE_DASHBOARD_KEY=
