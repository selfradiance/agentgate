# Rename this file to .env and fill in values as needed.
PORT=3000
AGENTGATE_HTTP_ALLOWLIST=
AGENTGATE_HTTP_TIMEOUT_MS=5000
AGENTGATE_HTTP_MAX_BODY_BYTES=65536

# Secret key for MCP HTTP endpoint auth. Set this to a long random string to require
# an x-agentgate-key header on all MCP requests. Leave unset to disable auth (local dev only).
AGENTGATE_MCP_KEY=
